    <!-- Bouclier Instagram -->
    <string name="shield_title">Bouclier Instagram</string>
    <string name="shield_settings_entry_body">Bloquer Reels, Explorer et le scroll infini en gardant les messages</string>
    <string name="shield_service_label">Clairjour — Bouclier Instagram</string>
    <string name="shield_service_description">Bloque les zones d\'Instagram que tu choisis (Reels, Explorer, fil…) en gardant les messages et la recherche de profils. Seul l\'écran d\'Instagram est lu, sur ton téléphone, et rien n\'est enregistré ni envoyé.</string>
    <string name="shield_status_on">Bouclier actif</string>
    <string name="shield_status_off">Bouclier désactivé</string>
    <string name="shield_status_off_body">Pour fonctionner, Clairjour doit être autorisé dans les réglages d\'accessibilité d\'Android.</string>
    <string name="shield_activate">Activer</string>
    <string name="shield_master">Toutes les protections</string>
    <string name="shield_rules_section">Ce que tu bloques</string>
    <string name="shield_rule_reels_tab">Onglet Reels</string>
    <string name="shield_rule_reels_tab_body">Ouvrir l\'onglet Reels te renvoie sur l\'accueil</string>
    <string name="shield_rule_direct_single_reel">Un seul reel à la fois</string>
    <string name="shield_rule_direct_single_reel_body">Un reel ouvert depuis le fil, un message, une story ou tes « J’aime » se lance (tu peux le mettre en pause) ; passer au suivant te fait revenir en arrière</string>
    <string name="shield_rule_other_reels">Reels ouverts ailleurs</string>
    <string name="shield_rule_other_reels_body">Depuis les notifications, la recherche ou ailleurs, le reel se ferme aussitôt</string>
    <string name="shield_rule_profile_reels">Reels des profils</string>
    <string name="shield_rule_profile_reels_body">Un reel ouvert depuis un profil se ferme aussitôt</string>
    <string name="shield_rule_explore_grid">Suggestions de la recherche</string>
    <string name="shield_rule_explore_grid_body">La grille de publications et de reels est masquée ; la barre de recherche reste utilisable</string>
    <string name="shield_rule_search_accounts_only">Recherche : comptes uniquement</string>
    <string name="shield_rule_search_accounts_only_body">Les résultats s\'ouvrent toujours sur l\'onglet Comptes</string>
    <string name="shield_rule_home_feed">Fil d\'accueil</string>
    <string name="shield_rule_home_feed_body">Le fil est masqué ; la barre des stories reste visible</string>
    <string name="shield_rule_stories">Stories</string>
    <string name="shield_rule_stories_body">Ouvrir une story te fait revenir en arrière</string>
    <string name="shield_disclosure_title">Avant d\'activer</string>
    <string name="shield_disclosure_body">Clairjour utilise le service d\'accessibilité d\'Android pour reconnaître les écrans d\'Instagram (Reels, Explorer, recherche, discussions) et, à ta place, revenir en arrière, toucher l\'onglet Comptes ou masquer une zone.\n\n• Seul l\'écran d\'Instagram est lu ; les autres apps sont ignorées.\n• Tout se passe sur ton téléphone : rien n\'est enregistré, collecté ni envoyé.\n• Tu peux le couper à tout moment dans les réglages d\'accessibilité d\'Android.\n\nSur l\'écran suivant, choisis « Clairjour — Bouclier Instagram » et active-le.</string>
    <string name="shield_disclosure_accept">J\'accepte</string>
    <string name="shield_disclosure_decline">Plus tard</string>
    <string name="shield_diagnostic">Mode diagnostic (debug)</string>
    <string name="shield_diagnostic_body">Écrit la structure de l\'écran Instagram dans logcat (tag ClairjourShield)</string>
    <string name="shield_status_on_body">Clairjour surveille Instagram et applique les blocages choisis ci-dessous.</string>
    <string name="shield_status_stopped">Bouclier arrêté par le téléphone</string>
    <string name="shield_restart">Relancer</string>
    <string name="shield_master_body">Les met en pause d\'un coup, sans toucher aux réglages Android</string>
    <string name="cd_shield_stopped_badge">Bouclier arrêté par le téléphone</string>
    <string name="shield_reliability_section">Fiabilité</string>
    <string name="shield_keep_alive_done">✓ fait</string>
    <string name="shield_keep_alive_title">Garder le bouclier allumé</string>
    <string name="shield_keep_alive_body">Certains téléphones ferment les applis en arrière-plan pour économiser la batterie, ce qui arrête le bouclier. Fais ces réglages une seule fois :</string>
    <string name="shield_keep_alive_body_xiaomi">Sur Xiaomi, Redmi et POCO, le système arrête le bouclier pour économiser la batterie, surtout quand tu fermes l\'appli depuis les récentes. Fais ces réglages une seule fois :</string>
    <string name="shield_keep_alive_autostart">Autoriser le démarrage automatique</string>
    <string name="shield_keep_alive_autostart_done">Démarrage automatique : autorisé ✓</string>
    <string name="shield_keep_alive_autostart_missing">Non autorisé : si tu fermes Clairjour depuis les applis récentes, le téléphone arrête le bouclier et ne le relance pas.</string>
    <string name="shield_keep_alive_battery">Batterie : aucune restriction</string>
    <string name="shield_keep_alive_battery_done">Batterie : aucune restriction ✓</string>
    <string name="shield_keep_alive_recents">Astuce : dans les applis récentes, appuie longuement sur Clairjour puis sur le cadenas. « Tout fermer » ne l\'arrêtera plus.</string>
    <string name="shield_cover_title">Pas de défilement ici</string>
    <string name="shield_cover_search_accounts">Chercher un compte</string>
    <string name="shield_status_stopped_body">Il paraît toujours activé dans les réglages, mais le téléphone l\'a fermé en arrière-plan. Touche « Relancer », désactive puis réactive « Clairjour — Bouclier Instagram ».</string>
